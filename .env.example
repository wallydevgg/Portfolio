# Configuración de Red/Ports
FRONTEND_PORT=3030
BACKEND_PORT=8000

# Base de Datos (Esto eliminará los WARN de tu log)
POSTGRES_USER=wallydev
POSTGRES_PASSWORD=your_password_here
POSTGRES_DB=portfolio
POSTGRES_SERVER=vps-postgres

# Seguridad JWT — generar con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your_secret_key_here
BACKEND_CORS_ORIGINS=["http://localhost:3001", "http://wallydev.dev"]

# Admin dashboard — hash bcrypt: cd backend && python -c "from core.security import get_password_hash; print(get_password_hash('tu_password'))"
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=your_bcrypt_hash_here
