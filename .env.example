# Configuración de Red/Ports
FRONTEND_PORT=3030
BACKEND_PORT=8000

# Base de Datos (Esto eliminará los WARN de tu log)
POSTGRES_USER=wallydev
POSTGRES_PASSWORD=your_password_here
POSTGRES_DB=portfolio
POSTGRES_SERVER=shared-db
POSTGRES_PORT=5432

# Seguridad JWT — generar con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your_secret_key_here
BACKEND_CORS_ORIGINS=["http://localhost:3001", "http://wallydev.dev"]

# Admin dashboard
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your_strong_password_here

# MinIO S3-compatible storage
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=shared-minio:9000
MINIO_PUBLIC_URL=http://localhost:9000
MINIO_BUCKET=portfolio
