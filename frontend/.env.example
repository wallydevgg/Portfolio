# Copiar a `.env.local` para desarrollo. Vite solo expone las que empiezan por
# VITE_, y las sustituye AL COMPILAR: cambiarlas exige reiniciar el dev server.

VITE_API_URL=http://localhost:8003/api/v1

# ─── Cloudflare Turnstile ─────────────────────────────────────────────────────
# Opcional. La site key de producción está en src/features/contact/turnstile.js
# porque es pública y va dentro del bundle de todos modos; esta variable solo la
# sobrescribe.
#
# Para local conviene ponerla, porque la de producción está atada al dominio
# wallydev.dev y en localhost el widget da error. Cloudflare publica dos claves
# de prueba que no requieren registrar nada:
#
#   siempre pasa:   1x00000000000000000000AA
#   siempre falla:  2x00000000000000000000AB   <- útil para probar el rechazo
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
